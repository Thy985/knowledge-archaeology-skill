{
  "_comment": "EK Graph 质量规则 + 知识库三层配比（宽底座 + 窄尖顶）",
  "version": "1.0.0",
  "ek_graph_gates": {
    "min_avg_edges": 1.0,
    "max_isolated_ratio": 0.20,
    "aggregation_coverage": 1.0,
    "ko_cluster_min": 3,
