    "facts_min": 100,
    "engineering_min": 40,
    "engineering_max": 60,
    "generalized_min": 7,
    "generalized_max": 12
  },
  "counterexample_budget": 3,
  "valid_enums": {
    "abstraction_levels": ["L0", "L1", "L2", "L3", "L4", "L5"],
    "epistemic_status": ["Fact", "Observation", "Hypothesis", "Validated Pattern", "Principle", "Law"],
    "flow_types": ["control", "state", "data", "evidence", "authority", "memory", "policy"],
    "ek_edge_types": ["mechanism", "subsystem", "causal", "dependency", "constraint", "contrast"],
    "aggregation_rules": ["R1", "R2", "R3", "R4"]
  }
